{
  "expo": {
    "name": "Dozemate",
    "slug": "Dozemate",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/image_5.jpeg",
    "scheme": "dozemate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slimiot.dozemate1",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.slimiot.dozemate1",
            "CFBundleURLSchemes": [
              "dozemate",
              "com.googleusercontent.apps.1034636618673-pip5kkij8nen5cnnc60s7p3bgrclndne"
            ]
          }
        ]
      },
      "appleTeamId": "YWP2VN6X4L"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/image_5.jpeg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.slimiot.dozemate1",
      "versionCode": 2,
      "backgroundColor": "#02041A",
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dozemate_transparent.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#02041A"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to your Dozemate."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-web-browser",
      "./plugins/withNetworkSecurityConfig"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1fd3773-0ba3-4a6c-8749-bc82aca45cc2"
      }
    }
  }
}